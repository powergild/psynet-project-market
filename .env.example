# 데이터 박스 — 필요한 환경변수는 둘뿐이다.
# 값은 절대 커밋하지 않는다. 레포는 public이다.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 셀 값을 새로 계산할 때 쓴다. 비어 있으면 캐시에 없는 칸은 "—"로 나간다
# (사이트는 정상 동작한다 — 빈 칸은 "근거 없음"이라는 뜻이고 거짓 숫자를 쓰지 않는다).
ANTHROPIC_API_KEY=

# 2026-11-09에 지운 것: ADMIN_PASSWORD · RESEND_API_KEY · ALERT_EMAIL_TO · ALERT_EMAIL_FROM.
# `/admin`과 접근 알림 메일은 피벗 전 「프로젝트 마켓」의 것이라 코드와 함께 사라졌다.
# ALERT_EMAIL_TO에는 실제 사내 메일 주소가 적혀 있었다 — public 레포에 PII는 두지 않는다.
